{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaTorrent",
  "version": "0.1.0",
  "identifier": "com.novatorrent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NovaTorrent",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Modern BitTorrent client",
    "longDescription": "NovaTorrent is a modern BitTorrent client with a Rust backend and a Next.js React frontend.",
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "windows": {
      "wix": {
        "fragmentPaths": ["./windows/fragments/protocols.wxs"],
        "componentRefs": ["NovaTorrentProtocolRegistration"]
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser"
      }
    }
  }
}
